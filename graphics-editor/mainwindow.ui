       <bool>true</bool>
      </property>
      <property name="plainText">
       <string>Key_L    // load project
Key_S    // save project

Key_J                // ScratchPage and MainPage Toggle
Ctrl + Key_Z    // the undo feature

Key_Q    // counter clock rotate Brush
Key_E    // clockwise rotate Brush
Key_X    // flip brush Horizontally  (left to right)
Key_Y    // flip brush Virtially     ( top to bottom)

Key_1    // Set PenSize to x1
Key_2    // Set PenSize to x2
Key_3    // Set PenSize to x4
Key_4    // Set PenSize to x6
Key_5    // Set PenSize to x8

Key_BracketLeft     // decrease de blending!
Key_BracketRight   // increase de blending!
    
Key_F1           // Plotter
Key_F2           // Line draw
Key_F3           // Pen draw
Key_F4           // Spray Can

Key_Minus    // zoom out screen
Key_Plus       // zoom in screen

Key_Space    // Pan Zoom area</string>
      </property>
     </widget>
