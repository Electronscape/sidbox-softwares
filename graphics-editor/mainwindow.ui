    border: 2px solid #808080;   /* swap border to look pressed */
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    background-color: #808080;
}
QPushButton:hover {
    background-color: #808080;   /* slightly lighter on hover */
}</string>
